    payment -.->|after 4s| promo_modal
    promo_modal -.->|dismiss| payment
    payment ==>|Pay| psp
    psp ==>|authorised| charge
    psp -.->|rejected| declined
    charge -->|insert| orders_db
    charge ==>|201| confirm
    confirm ==> done
    payment -.->|back| address

